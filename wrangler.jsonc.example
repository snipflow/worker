{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-09",
  "vars": {
    "SNIPFLOW_TOTAL_STORAGE_LIMIT": "104857600",
    "SNIPFLOW_MAX_SNIP_SIZE": "10485760",
    "SNIPFLOW_DISGUISE": "false",
    "SNIPFLOW_CORS_ORIGINS": "https://your-page.example.com"
  },
  "secrets_store_secrets": [
    {
      "binding": "SNIPFLOW_API_TOKEN",
      "store_id": "<YOUR_SECRETS_STORE_ID>",
      "secret_name": "SNIPFLOW_API_TOKEN"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SNIPFLOW_KV",
      "id": "<YOUR_KV_NAMESPACE_ID>"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SNIPFLOW_R2",
      "bucket_name": "<YOUR_R2_BUCKET_NAME>"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
